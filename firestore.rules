rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // =========================================
    // AUTH HELPERS
    // =========================================

    function signedIn() {
      return request.auth != null;
    }


    function customer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider
          == "anonymous";
    }


    function staff() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider
          != "anonymous";
    }



    // =========================================
    // MENU
    // =========================================

    match /menu/{menuId} {

      allow read:
        if true;

      allow create, update, delete:
        if staff();

    }



    // =========================================
    // CATEGORIES
    // =========================================

    match /categories/{categoryId} {

      allow read:
        if true;

      allow create, update, delete:
        if staff();

    }



    // =========================================
    // SETTINGS
    // =========================================

    match /settings/{settingId} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if staff();

    }



    // =========================================
    // ORDERS
    // =========================================

    match /orders/{orderId} {


      // =======================================
      // READ ONE ORDER
      // =======================================

      allow get:
        if staff()
        ||
        (
          customer()
          &&
          resource.data.customerUid ==
            request.auth.uid
        );



      // =======================================
      // LIST ORDERS
      // =======================================

      // Only kitchen/admin/staff can list
      // all orders.

      allow list:
        if staff();



      // =======================================
      // CREATE ORDER
      // =======================================

      allow create:
        if customer()

        &&

        request.resource.data.customerUid ==
          request.auth.uid

        &&

        request.resource.data.tableSessionId
          is string

        &&

        request.resource.data.table
          is int

        &&

        request.resource.data.table >= 1

        &&

        request.resource.data.table <= 12

        &&

        request.resource.data.status ==
          "Pending"

        &&

        request.resource.data.paymentStatus ==
          "Unpaid"

        &&

        request.resource.data.items
          is list

        &&

        request.resource.data.items.size() > 0

        &&

        request.resource.data.batches
          is list

        &&

        request.resource.data.batches.size() > 0

        &&

        request.resource.data.total >= 0;



      // =======================================
      // STAFF UPDATE
      // =======================================

      allow update:
        if staff();



      // =======================================
      // CUSTOMER UPDATE
      // =======================================
      //
      // Customer can modify their own unpaid
      // order.
      //
      // This is intentionally restricted.
      //
      // =======================================

      allow update:
        if customer()

        &&

        resource.data.customerUid ==
          request.auth.uid

        &&

        request.resource.data.customerUid ==
          resource.data.customerUid

        &&

        request.resource.data.table ==
          resource.data.table

        &&

        request.resource.data.tableSessionId ==
          resource.data.tableSessionId

        &&

        resource.data.paymentStatus ==
          "Unpaid"

        &&

        request.resource.data.paymentStatus ==
          "Unpaid"

        &&

        request.resource.data.paymentMethod ==
          null

        &&

        request.resource.data.paidAt ==
          null

        &&

        resource.data.status !=
          "Completed"

        &&

        request.resource.data.status ==
          "Pending"

        &&

        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          "items",
          "batches",
          "total",
          "status",
          "customerName",
          "phone",
          "instructions"
        ]);



      // =======================================
      // DELETE
      // =======================================

      allow delete:
        if staff();

    }



    // =========================================
    // DENY EVERYTHING ELSE
    // =========================================

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}