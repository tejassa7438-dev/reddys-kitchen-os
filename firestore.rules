rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================
    // AUTH HELPERS
    // =========================================

    function signedIn() {
      return request.auth != null;
    }

    function customer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider
          == "anonymous";
    }

    function staff() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider
          != "anonymous";
    }


    // =========================================
    // MENU
    // =========================================

    match /menu/{menuId} {

      allow read:
        if true;

      allow create, update, delete:
        if staff();
    }


    // =========================================
    // CATEGORIES
    // =========================================

    match /categories/{categoryId} {

      allow read:
        if true;

      allow create, update, delete:
        if staff();
    }


    // =========================================
    // SETTINGS
    // =========================================

    match /settings/{settingId} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if staff();
    }


    // =========================================
    // TABLE SESSIONS
    // =========================================
    //
    // QR session documents are trusted by
    // Firestore rules.
    //
    // The document ID is the QR session token.
    //
    // Example:
    //
    // tableSessions/TABLE_1_TOKEN
    //
    // {
    //   table: 1,
    //   active: true
    // }
    //
    // Customers cannot modify these documents.
    //
    // =========================================

    match /tableSessions/{sessionId} {

      allow read, write:
        if staff();
    }


    // =========================================
    // TABLE STATE
    // =========================================

    match /tableState/{tableId} {

      allow read, create, update, delete:
        if staff();
    }


    // =========================================
    // ORDERS
    // =========================================

    match /orders/{orderId} {


      // =======================================
      // READ ONE ORDER
      // =======================================

      allow get:
        if staff()
        ||
        (
          customer()
          &&
          resource.data.customerUid ==
            request.auth.uid
        );


      // =======================================
      // LIST ORDERS
      // =======================================

      allow list:
        if staff();


      // =======================================
      // CREATE ORDER
      // =======================================
      //
      // CUSTOMER MUST:
      //
      // 1. Be anonymous-authenticated
      // 2. Own the order
      // 3. Provide a valid table
      // 4. Provide a valid QR session
      // 5. QR session must exist
      // 6. QR session must be active
      // 7. QR session must belong to
      //    the exact submitted table
      //
      // =======================================

      allow create:
        if customer()

        // -------------------------------------
        // CUSTOMER OWNERSHIP
        // -------------------------------------

        &&

        request.resource.data.customerUid ==
          request.auth.uid

        // -------------------------------------
        // TABLE NUMBER
        // -------------------------------------

        &&

        request.resource.data.table
          is int

        &&

        request.resource.data.table >= 1

        &&

        request.resource.data.table <= 12

        // -------------------------------------
        // TABLE SESSION ID
        // -------------------------------------

        &&

        request.resource.data.tableSessionId
          is string

        // -------------------------------------
        // SESSION MUST EXIST
        // -------------------------------------

        &&

        exists(
          /databases/$(database)/documents/tableSessions/$(request.resource.data.tableSessionId)
        )

        // -------------------------------------
        // SESSION MUST BE ACTIVE
        // -------------------------------------

        &&

        get(
          /databases/$(database)/documents/tableSessions/$(request.resource.data.tableSessionId)
        ).data.active == true

        // -------------------------------------
        // CRITICAL SECURITY CHECK
        //
        // SESSION TABLE MUST MATCH
        // ORDER TABLE
        // -------------------------------------

        &&

        get(
          /databases/$(database)/documents/tableSessions/$(request.resource.data.tableSessionId)
        ).data.table ==
          request.resource.data.table

        // -------------------------------------
        // INITIAL ORDER STATE
        // -------------------------------------

        &&

        request.resource.data.status ==
          "Pending"

        &&

        request.resource.data.paymentStatus ==
          "Unpaid"

        // -------------------------------------
        // ORDER CONTENT
        // -------------------------------------

        &&

        request.resource.data.items
          is list

        &&

        request.resource.data.items.size() > 0

        &&

        request.resource.data.batches
          is list

        &&

        request.resource.data.batches.size() > 0

        &&

        request.resource.data.total >= 0;


      // =======================================
      // STAFF UPDATE
      // =======================================

      allow update:
        if staff();


      // =======================================
      // CUSTOMER UPDATE
      // =======================================

      allow update:
        if customer()

        &&

        resource.data.customerUid ==
          request.auth.uid

        &&

        request.resource.data.customerUid ==
          resource.data.customerUid

        // -------------------------------------
        // TABLE CANNOT CHANGE
        // -------------------------------------

        &&

        request.resource.data.table ==
          resource.data.table

        // -------------------------------------
        // SESSION CANNOT CHANGE
        // -------------------------------------

        &&

        request.resource.data.tableSessionId ==
          resource.data.tableSessionId

        // -------------------------------------
        // PAYMENT CANNOT BE CHANGED
        // -------------------------------------

        &&

        resource.data.paymentStatus ==
          "Unpaid"

        &&

        request.resource.data.paymentStatus ==
          "Unpaid"

        &&

        request.resource.data.paymentMethod ==
          null

        &&

        request.resource.data.paidAt ==
          null

        // -------------------------------------
        // ORDER STATUS
        // -------------------------------------

        &&

        resource.data.status !=
          "Completed"

        &&

        request.resource.data.status ==
          "Pending"

        // -------------------------------------
        // ONLY ALLOWED FIELDS MAY CHANGE
        // -------------------------------------

        &&

        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          "items",
          "batches",
          "total",
          "status",
          "customerName",
          "phone",
          "instructions"
        ]);


      // =======================================
      // DELETE
      // =======================================

      allow delete:
        if staff();

    }


    // =========================================
    // DENY EVERYTHING ELSE
    // =========================================

    match /{document=**} {

      allow read, write:
        if false;
    }

  }
}